# Flask Environment Configuration
FLASK_ENV=development
FLASK_DEBUG=1
PORT=5000

# Security Secrets (Generate secure random keys for production)
SECRET_KEY=smartstudy-super-secret-key-change-in-production-2026
JWT_SECRET_KEY=smartstudy-jwt-secret-key-change-in-production-2026
JWT_ACCESS_TOKEN_EXPIRES_DAYS=7

# Database Configuration (SQLite for Hackathon)
DATABASE_URL=sqlite:///smartstudy.db

# AI Integration
AI_API_KEY=your_ai_api_key_here
AI_PROVIDER=gemini # Options: gemini, openai, mock
AI_MODEL=gemini-1.5-flash

# CORS Allowed Origins
CORS_ORIGINS=*
